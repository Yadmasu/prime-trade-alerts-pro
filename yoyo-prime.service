[Unit]
Description=YOYO Prime Trade 24/7 Scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linuxuser
WorkingDirectory=/home/linuxuser/prime-trade-alerts-pro
EnvironmentFile=/home/linuxuser/prime-trade-alerts-pro/.env
ExecStart=/home/linuxuser/prime-trade-alerts-pro/.venv/bin/python /home/linuxuser/prime-trade-alerts-pro/scanner.py
Restart=always
RestartSec=30
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
